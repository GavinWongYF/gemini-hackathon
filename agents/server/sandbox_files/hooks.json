{
  "library-guard": {
    "enabled": true,
    "pre_tool_execution": [
      {"matcher": "write_to_file|replace_file_content|code_execution|delete_file",
       "hooks": [{"type": "command", "command": "python3 /.agents/hooks-scripts/gate.py", "timeout": 10}]}
    ],
    "post_tool_execution": [
      {"matcher": "write_to_file|replace_file_content|code_execution|delete_file",
       "hooks": [{"type": "command", "command": "python3 /.agents/hooks-scripts/audit.py", "timeout": 10}]}
    ]
  }
}
