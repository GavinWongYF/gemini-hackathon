        "player_arm_zone": "$player.arm_zone",
        "player_last_side": "$player.side",
        "player_last_shot_type": "$player.shot_type",
        "rally_length": "$exchange",
        "swing_early_guess": "$tell.early_guess",
        "swing_backswing": "$tell.backswing",
        "swing_initial_speed": "$tell.initial_speed",
        "swing_side": "$tell.side",
        "swing_arm_zone": "$tell.arm_zone"
