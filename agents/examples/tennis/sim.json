  "round": {
    "max_exchanges": 6,
    "exchange": {
      "order": "npc_first",
      "npc": {
        "decisions": [
          "shot_type",
          "aim",
          "position"
        ],
        "event": {
          "name": "shot",
          "data": {
            "rally": "$exchange",
            "shot_type": "$picked.shot_type",
            "lands": "$picked.aim",
            "result": "in"
          }
        }
      },
      "tell": {
        "event": "swing_start",
        "copy": {
          "side": "side",
          "arm_zone": "arm_zone",
          "early_guess": "shot_type"
        },
        "match": {
          "side": 0.92,
          "arm_zone": 0.92,
          "early_guess": 0.78
        }
      },
      "react": {
        "decisions": [
          "anticipate"
        ],
        "event": {
          "name": "anticipate",
          "data": {
            "move": "$picked.anticipate"
          }
        }
      },
      "player": {
        "event": "shot",
        "data": {
          "rally": "$exchange",
          "other_position": "$picked.position"
        }
