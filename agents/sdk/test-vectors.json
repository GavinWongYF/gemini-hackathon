{
  "about": "Cases for `pick` whose answer doesn't depend on chance. `expect.option` is the exact answer. `expect.one_of` lists the answers allowed when chance picks among them. Every SDK must pass all of them.",
  "cases": [
    {
      "name": "rule_fires",
      "about": "A rule whose conditions hold and whose option is legal decides.",
      "npc": "opponent",
      "decision": "shot_type",
      "legal": [
        "flat",
        "lob",
        "drop"
      ],
      "behaviour": {
        "version": 1,
        "npcs": {
          "opponent": {
            "decisions": {
              "shot_type": {
                "flat": {
                  "base": 0
                },
                "lob": {
                  "base": 0
                },
                "drop": {
                  "base": 1
                }
              }
            },
            "rules": [
              {
                "if": [
                  {
                    "fact": "player_position",
                    "in": [
                      "left_short",
                      "middle_short",
                      "right_short"
                    ]
                  }
                ],
                "do": {
                  "shot_type": "lob"
                },
                "why": "test"
              }
            ]
          }
        }
      },
      "values": {},
      "facts": {
        "player_position": "middle_short"
      },
      "expect": {
        "option": "lob",
        "by_rule": true
      }
    },
